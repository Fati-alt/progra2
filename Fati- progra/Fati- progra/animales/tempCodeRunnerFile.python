import tkinter as tk
from PIL import Image, ImageTk

def desicion():
    global opcion  # <--- Agregado para que reconozca la variable
    variable = opcion.get()
    if variable == "Elefante":
        ventana_2()
    elif variable == "Jirafa":
        ventana_3()
    elif variable == "Castor":
        ventana_4()
    elif variable == "Leon":
        ventana_5() # <--- Faltaban los paréntesis ()

def ventana_principal():
    global ven1, opcion # <--- Agregado opcion como global
    ven1 = tk.Tk()
    ven1.title("Ventana principal")
    ven1.geometry("550x500")
    ven1.config(bg="light blue")

    etiqueta1 = tk.Label(ven1, text="Reino animal", bg="light blue")
    etiqueta1.pack()

    frame_contenedor = tk.Frame(ven1, bg="light blue")
    frame_contenedor.pack(pady=20)

    # Cargar la imagen 
    imagen1 = Image.open("C:/Users/SALON102/Desktop/Fati- progra/reinoa1.png")
    imagen1 = imagen1.resize((300, 200)) 
    imagen1_tk = ImageTk.PhotoImage(imagen1)
    
    label_imagen = tk.Label(frame_contenedor, image=imagen1_tk)
    label_imagen.image = imagen1_tk 
    label_imagen.pack(side="left", padx=10)

    # Radiobotones
    opcion = tk.StringVar(value="Elefante") # <--- Corregido StringVarVar y se puso valor inicial
    tk.Radiobutton(frame_contenedor, text="Elefante", variable=opcion, value="Elefante", bg="light blue").pack(anchor="w")
    tk.Radiobutton(frame_contenedor, text="Jirafa", variable=opcion, value="Jirafa", bg="light blue").pack(anchor="w")
    tk.Radiobutton(frame_contenedor, text="Castor", variable=opcion, value="Castor", bg="light blue").pack(anchor="w")
    tk.Radiobutton(frame_contenedor, text="Leon", variable=opcion, value="Leon", bg="light blue").pack(anchor="w")

    boton1 = tk.Button(ven1, text="Ir a la descripcion", command=desicion)
    boton1.pack(pady=20)

    ven1.mainloop()

# ... (El resto de tus funciones ventana_2 a ventana_5 y destruir_ventana se mantienen igual)

def ventana_2():
    global ven2
    ven1.destroy() 
    ven2 = tk.Tk()
    ven2.title("Ventana secundaria")
    ven2.geometry("300x500")
    ven2.config(bg="light green")
    etiqueta2 = tk.Label(ven2, text="Esta es la ventana 2")
    etiqueta2.pack()
    frame_contenedor = tk.Frame(ven1, bg="light blue")
    frame_contenedor.pack(pady=20)
    # Cargar la imagen 
    imagen2 = Image.open("C:/Users/SALON102/Desktop/Fati- progra/elefante1.jpg")
    imagen2= imagen2.resize((300, 200)) 
    imagen2_tk = ImageTk.PhotoImage(imagen2)
    
    label_imagen = tk.Label(frame_contenedor, image=imagen2_tk)
    label_imagen.image = imagen2_tk 
    label_imagen.pack(side="left", padx=10)
    boton2 = tk.Button(ven2, text="Ir a ventana 3", command=ventana_3)
    boton2.pack(pady=20)
    ven2.mainloop()

def ventana_3():
    global ven3
    ven2.destroy()
    ven3 = tk.Tk()
    ven3.title("Ventana terciaria")
    ven3.geometry("300x500")
    ven3.config(bg="pink")
    etiqueta3 = tk.Label(ven3, text="Esta es la ventana 3")
    etiqueta3.pack()
    boton3 = tk.Button(ven3, text="Ir a la ventana 4", command=ventana_4)
    boton3.pack(pady=20)
    ven3.mainloop()

def ventana_4():
    global ven4
    ven3.destroy()
    ven4 = tk.Tk()
    ven4.title("Ventana cuarta")
    ven4.geometry("300x500")
    ven4.config(bg="light yellow")
    etiqueta4 = tk.Label(ven4, text="Esta es la ventana 4")
    etiqueta4.pack()
    boton4 = tk.Button(ven4, text="Ir a ventana 5", command=ventana_5)
    boton4.pack(pady=20)
    ven4.mainloop()

def ventana_5():
    global ven5
    ven4.destroy()
    ven5 = tk.Tk()
    ven5.title("Ventana quinta")
    ven5.geometry("300x500")
    ven5.config(bg="red")
    etiqueta5 = tk.Label(ven5, text="Esta es la ventana 5")
    etiqueta5.pack()
    boton5 = tk.Button(ven5, text="Regresar", command=lambda: destruir_ventana(ven5))
    boton5.pack(pady=20)
    ven5.mainloop()

def destruir_ventana(ventana_actual):
    ventana_actual.destroy()
    ventana_principal()

ventana_principal()

